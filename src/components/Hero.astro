---
import { resumeData } from '../data/resumeData';
import { Download, Mail, Linkedin, MapPin, ExternalLink, Sparkles, Terminal, Phone, Sun, Moon, Menu, X } from 'lucide-astro';

const { personal, metrics, executiveSnapshot } = resumeData;
---

<header class="pt-8 sm:pt-12 pb-16 border-b border-slate-200 dark:border-slate-800/80 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Action Bar -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-50 dark:bg-brand-500/10 border border-brand-200 dark:border-brand-500/20 text-brand-700 dark:text-brand-300 text-xs font-mono font-medium">
        <span class="w-2 h-2 rounded-full bg-brand-500 dark:bg-brand-400 animate-pulse"></span>
        <span>Account Leadership & Technical Director</span>
      </div>

      <!-- Desktop Action Bar (Hidden on Mobile) -->
      <div class="hidden md:flex items-center gap-3 print:hidden">
        <!-- Light / Dark Mode Toggle Button -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle theme"
          class="inline-flex items-center justify-center p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shadow-sm"
        >
          <Sun class="w-4 h-4 hidden dark:block text-amber-400" />
          <Moon class="w-4 h-4 block dark:hidden text-slate-700" />
        </button>

        <button
          onclick="window.print()"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-sm font-medium transition-all shadow-sm"
        >
          <Download class="w-4 h-4 text-brand-700 dark:text-brand-400" />
          <span>Download PDF</span>
        </button>
        
        <a
          href={`mailto:${personal.email}`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium transition-all shadow-md shadow-brand-900/20"
        >
          <Mail class="w-4 h-4" />
          <span>Contact Turner</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button (Visible only on Mobile) -->
      <div class="flex items-center gap-2 md:hidden print:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Open navigation menu"
          class="inline-flex items-center justify-center p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shadow-sm"
        >
          <Menu class="w-5 h-5" />
        </button>
      </div>
    </div>

    <!-- Mobile Slide-Out Drawer Backdrop -->
    <div
      id="mobile-backdrop"
      class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-40 hidden md:hidden opacity-0 transition-opacity duration-300 print:hidden"
    ></div>

    <!-- Mobile Slide-Out Drawer (Right Side) -->
    <div
      id="mobile-drawer"
      class="fixed top-0 right-0 bottom-0 w-72 bg-white dark:bg-slate-900 border-l border-slate-200 dark:border-slate-800 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col justify-between p-6 print:hidden"
    >
      <div class="space-y-6">
        <!-- Drawer Header -->
        <div class="flex items-center justify-end pb-4 border-b border-slate-100 dark:border-slate-800">
          <button
            id="mobile-close-btn"
            type="button"
            aria-label="Close menu"
            class="p-2 rounded-lg text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors"
          >
            <X class="w-5 h-5" />
          </button>
        </div>

        <!-- Action Items -->
        <div class="space-y-3">
          <button
            onclick="window.print()"
            class="w-full flex items-center gap-3 px-4 py-3 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-sm font-medium transition-all"
          >
            <Download class="w-4 h-4 text-brand-700 dark:text-brand-400" />
            <span>Download Resume (PDF)</span>
          </button>

          <a
            href={`mailto:${personal.email}`}
            class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium transition-all shadow-md"
          >
            <Mail class="w-4 h-4" />
            <span>Contact Turner</span>
          </a>
        </div>
      </div>

      <!-- Drawer Bottom: Theme Switcher & Footer -->
      <div class="pt-6 border-t border-slate-100 dark:border-slate-800 space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-slate-500 dark:text-slate-400">Appearance</span>
          <button
            id="theme-toggle-mobile"
            type="button"
            aria-label="Toggle theme"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono border border-slate-200 dark:border-slate-700"
          >
            <Sun class="w-3.5 h-3.5 hidden dark:block text-amber-400" />
            <Moon class="w-3.5 h-3.5 block dark:hidden text-slate-700" />
            <span class="block dark:hidden">Dark</span>
            <span class="hidden dark:block">Light</span>
          </button>
        </div>
        
        <p class="text-[11px] font-mono text-slate-400 dark:text-slate-500">
          © {new Date().getFullYear()} Turner Walters
        </p>
      </div>
    </div>

    <!-- Main Hero Content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-4">
        <!-- Name Header & Headshot Avatar -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">
          <img
            src="/headshot.jpg"
            alt="Turner Walters"
            class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl border-2 border-slate-200 dark:border-slate-800 object-cover shadow-md shrink-0 bg-slate-100 dark:bg-slate-800 print:w-16 print:h-16"
          />
          <div>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white print:text-slate-900">
              {personal.name}
            </h1>
            <p class="text-xl sm:text-2xl font-semibold text-brand-700 dark:text-brand-400 mt-1 print:text-brand-700">
              {personal.title}
            </p>
          </div>
        </div>

        <p class="text-lg text-slate-700 dark:text-slate-300 font-light leading-relaxed max-w-2xl print:text-slate-700 pt-1">
          {personal.tagline}
        </p>

        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed print:text-slate-700 pt-1">
          {personal.summary}
        </p>

        <!-- Social & Contact Meta -->
        <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-slate-600 dark:text-slate-400 pt-3 print:text-slate-700">
          <div class="flex items-center gap-1.5">
            <MapPin class="w-4 h-4 text-slate-500 dark:text-slate-500" />
            <span>{personal.location}</span>
          </div>
          <span class="text-slate-300 dark:text-slate-700 print:hidden">•</span>
          <a href={`tel:${personal.phone.replace(/[^0-9+]/g, '')}`} class="flex items-center gap-1.5 hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
            <Phone class="w-4 h-4 text-slate-500 dark:text-slate-500" />
            <span>{personal.phone}</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700 print:hidden">•</span>
          <a href={`mailto:${personal.email}`} class="flex items-center gap-1.5 hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
            <Mail class="w-4 h-4 text-slate-500 dark:text-slate-500" />
            <span>{personal.email}</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700 print:hidden">•</span>
          <a href={personal.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
            <Linkedin class="w-4 h-4 text-slate-500 dark:text-slate-500" />
            <span>LinkedIn</span>
            <ExternalLink class="w-3 h-3 print:hidden" />
          </a>
        </div>
      </div>

      <!-- Quick Executive Tech Card -->
      <div class="lg:col-span-4 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 p-6 shadow-sm dark:shadow-none backdrop-blur-sm print:bg-slate-50 print:border-slate-300">
        <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-slate-800 print:border-slate-300 pb-3">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-2">
            <Terminal class="w-4 h-4 text-brand-700 dark:text-brand-400" />
            Executive Snapshot
          </span>
          <Sparkles class="w-4 h-4 text-brand-600 dark:text-brand-400 print:hidden" />
        </div>
        
        <div class="space-y-3.5">
          {executiveSnapshot.map(item => (
            <div class="flex items-start justify-between gap-3 text-xs">
              <span class="text-slate-500 dark:text-slate-400 print:text-slate-600 shrink-0 font-medium">{item.label}:</span>
              <span class="font-semibold text-slate-800 dark:text-slate-200 print:text-slate-900 text-right leading-snug">{item.value}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Impact Metrics Row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-12">
      {metrics.map(metric => (
        <div class="p-5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none hover:border-slate-300 dark:hover:border-slate-700 transition-all print:bg-white print:border-slate-300">
          <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white print:text-slate-900 font-mono">
            {metric.value}
          </div>
          <div class="text-xs font-semibold text-brand-700 dark:text-brand-400 mt-1 uppercase tracking-wide print:text-brand-700">
            {metric.label}
          </div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 print:text-slate-600">
            {metric.subtext}
          </div>
        </div>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  // Theme Toggle Handlers
  const handleToggle = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");
    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  };

  document.getElementById("theme-toggle")?.addEventListener("click", handleToggle);
  document.getElementById("theme-toggle-mobile")?.addEventListener("click", handleToggle);

  // Mobile Slide-Out Drawer Handlers
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileCloseBtn = document.getElementById("mobile-close-btn");
  const mobileBackdrop = document.getElementById("mobile-backdrop");
  const mobileDrawer = document.getElementById("mobile-drawer");

  const openDrawer = () => {
    mobileBackdrop.classList.remove("hidden");
    setTimeout(() => {
      mobileBackdrop.classList.remove("opacity-0");
      mobileDrawer.classList.remove("translate-x-full");
    }, 10);
  };

  const closeDrawer = () => {
    mobileBackdrop.classList.add("opacity-0");
    mobileDrawer.classList.add("translate-x-full");
    setTimeout(() => {
      mobileBackdrop.classList.add("hidden");
    }, 300);
  };

  mobileBtn?.addEventListener("click", openDrawer);
  mobileCloseBtn?.addEventListener("click", closeDrawer);
  mobileBackdrop?.addEventListener("click", closeDrawer);
</script>
