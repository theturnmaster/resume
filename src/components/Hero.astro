---
import { resumeData } from '../data/resumeData';
import { Download, Mail, Linkedin, Globe, MapPin, ExternalLink, Sparkles, Terminal, Phone } from 'lucide-astro';

const { personal, metrics } = resumeData;
---

<header class="pt-12 pb-16 border-b border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Action Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8 print:hidden">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-mono font-medium">
        <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
        <span>Account Leadership & Technical Director</span>
      </div>

      <div class="flex items-center gap-3">
        <button
          onclick="window.print()"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 text-sm font-medium transition-all shadow-sm hover:border-slate-600"
        >
          <Download class="w-4 h-4 text-brand-400" />
          <span>Download PDF</span>
        </button>
        <a
          href={`mailto:${personal.email}`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium transition-all shadow-md shadow-brand-900/20"
        >
          <Mail class="w-4 h-4" />
          <span>Contact Turner</span>
        </a>
      </div>
    </div>

    <!-- Main Hero Content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-4">
        <div>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white print:text-slate-900">
            {personal.name}
          </h1>
          <p class="text-xl sm:text-2xl font-semibold text-brand-400 mt-2 print:text-brand-600">
            {personal.title}
          </p>
        </div>

        <p class="text-lg text-slate-300 font-light leading-relaxed max-w-2xl print:text-slate-700">
          {personal.tagline}
        </p>

        <p class="text-sm text-slate-400 leading-relaxed print:text-slate-700 pt-2">
          {personal.summary}
        </p>

        <!-- Social & Contact Meta -->
        <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-slate-400 pt-3 print:text-slate-700">
          <div class="flex items-center gap-1.5">
            <MapPin class="w-4 h-4 text-slate-500" />
            <span>{personal.location}</span>
          </div>
          <span class="text-slate-700 print:hidden">•</span>
          <a href={`tel:${personal.phone.replace(/[^0-9+]/g, '')}`} class="flex items-center gap-1.5 hover:text-brand-400 transition-colors">
            <Phone class="w-4 h-4 text-slate-500" />
            <span>{personal.phone}</span>
          </a>
          <span class="text-slate-700 print:hidden">•</span>
          <a href={`mailto:${personal.email}`} class="flex items-center gap-1.5 hover:text-brand-400 transition-colors">
            <Mail class="w-4 h-4 text-slate-500" />
            <span>{personal.email}</span>
          </a>
          <span class="text-slate-700 print:hidden">•</span>
          <a href={personal.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-brand-400 transition-colors">
            <Linkedin class="w-4 h-4 text-slate-500" />
            <span>LinkedIn</span>
            <ExternalLink class="w-3 h-3 print:hidden" />
          </a>
          <span class="text-slate-700 print:hidden">•</span>
          <a href={personal.website} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-brand-400 transition-colors">
            <Globe class="w-4 h-4 text-slate-500" />
            <span>turnerwalters.com</span>
            <ExternalLink class="w-3 h-3 print:hidden" />
          </a>
        </div>
      </div>

      <!-- Quick Executive Tech Card -->
      <div class="lg:col-span-4 rounded-2xl bg-slate-900/80 border border-slate-800 p-6 backdrop-blur-sm print:bg-slate-50 print:border-slate-300">
        <div class="flex items-center justify-between mb-4 border-b border-slate-800 print:border-slate-300 pb-3">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 flex items-center gap-2">
            <Terminal class="w-4 h-4 text-brand-400" />
            Executive Snapshot
          </span>
          <Sparkles class="w-4 h-4 text-brand-400 print:hidden" />
        </div>
        
        <div class="space-y-4">
          <div class="flex justify-between items-baseline">
            <span class="text-xs text-slate-400 print:text-slate-600">P&L Portfolio:</span>
            <span class="text-xs font-semibold text-slate-200 print:text-slate-900">$2M (50% Agency Rev)</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-xs text-slate-400 print:text-slate-600">Client Retention:</span>
            <span class="text-xs font-semibold text-slate-200 print:text-slate-900">100% Rate</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-xs text-slate-400 print:text-slate-600">Specialization:</span>
            <span class="text-xs font-semibold text-slate-200 print:text-slate-900">AI SaaS, Web Apps & AEO</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-xs text-slate-400 print:text-slate-600">Education:</span>
            <span class="text-xs font-semibold text-slate-200 print:text-slate-900">B.S. CS (UNC Chapel Hill)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Impact Metrics Row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-12">
      {metrics.map(metric => (
        <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800/80 hover:border-slate-700 transition-all print:bg-white print:border-slate-300">
          <div class="text-2xl sm:text-3xl font-extrabold text-white print:text-slate-900 font-mono">
            {metric.value}
          </div>
          <div class="text-xs font-semibold text-brand-400 mt-1 uppercase tracking-wide print:text-brand-600">
            {metric.label}
          </div>
          <div class="text-xs text-slate-400 mt-1 line-clamp-2 print:text-slate-600">
            {metric.subtext}
          </div>
        </div>
      ))}
    </div>
  </div>
</header>
