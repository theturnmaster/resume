---
import { resumeData } from '../data/resumeData';
import { GraduationCap, Award, Mail, Linkedin, Github, FileText } from 'lucide-astro';

const { education, certifications, personal } = resumeData;
---

<footer class="py-12 bg-slate-950 text-slate-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Education & Certifications Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-b border-slate-800 pb-12">
      <!-- Education -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-brand-400 font-semibold mb-4 flex items-center gap-2">
          <GraduationCap class="w-4 h-4" />
          Education
        </h3>
        <div class="space-y-4">
          {education.map(edu => (
            <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 print:bg-white print:border-slate-300">
              <div class="flex justify-between items-baseline">
                <h4 class="font-bold text-white print:text-slate-900">{edu.degree}</h4>
                <span class="text-xs font-mono text-slate-500">{edu.year}</span>
              </div>
              <p class="text-sm text-brand-400 mt-0.5">{edu.institution}</p>
              <p class="text-xs text-slate-400 mt-2">{edu.details}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Certifications -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-brand-400 font-semibold mb-4 flex items-center gap-2">
          <Award class="w-4 h-4" />
          Certifications & Credentials
        </h3>
        <div class="space-y-3">
          {certifications.map(cert => (
            <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex justify-between items-center print:bg-white print:border-slate-300">
              <div>
                <h4 class="text-sm font-bold text-slate-100 print:text-slate-900">{cert.name}</h4>
                <p class="text-xs text-slate-400">{cert.issuer}</p>
              </div>
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-slate-800 text-slate-300 border border-slate-700 print:bg-slate-100 print:text-slate-700">
                {cert.year}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Final Call to Action & Footer -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 print:hidden">
      <div>
        <h4 class="text-lg font-bold text-white">Let's connect on strategic opportunities</h4>
        <p class="text-xs text-slate-400 mt-1">Open to Senior Technical Account Director & Enterprise Leadership roles.</p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={`mailto:${personal.email}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium transition-all shadow-md"
        >
          <Mail class="w-4 h-4" />
          <span>Send Message</span>
        </a>
        <a
          href={personal.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 text-sm font-medium transition-all"
        >
          <Linkedin class="w-4 h-4 text-brand-400" />
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

    <div class="text-center text-xs text-slate-600 font-mono pt-4 border-t border-slate-900">
      © {new Date().getFullYear()} {personal.name} — Built with Astro & Tailwind CSS. Zero JavaScript footprint.
    </div>
  </div>
</footer>
