---
import { resumeData } from '../data/resumeData';
import { GraduationCap, Mail, Linkedin } from 'lucide-astro';

const { education, personal } = resumeData;
---

<footer class="py-12 bg-white dark:bg-slate-950 text-slate-700 dark:text-slate-300 border-t border-slate-200 dark:border-slate-900 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Education Section -->
    <div class="border-b border-slate-200 dark:border-slate-800 pb-12">
      <h3 class="text-xs font-mono uppercase tracking-widest text-brand-600 dark:text-brand-400 font-semibold mb-4 flex items-center gap-2">
        <GraduationCap class="w-4 h-4" />
        Education
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {education.map(edu => (
          <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 print:bg-white print:border-slate-300">
            <div class="flex justify-between items-baseline">
              <h4 class="font-bold text-slate-900 dark:text-white print:text-slate-900">{edu.degree}</h4>
              <span class="text-xs font-mono text-slate-500">{edu.location}</span>
            </div>
            <p class="text-sm font-medium text-brand-600 dark:text-brand-400 mt-1">{edu.institution}</p>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">{edu.details}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Final Call to Action & Footer -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 print:hidden">
      <div>
        <h4 class="text-lg font-bold text-slate-900 dark:text-white">Let's connect on strategic leadership & tech opportunities</h4>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 flex flex-wrap items-center gap-2">
          <span>{personal.location}</span>
          <span class="text-slate-300 dark:text-slate-700">•</span>
          <a href={`tel:${personal.phone.replace(/[^0-9+]/g, '')}`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
            {personal.phone}
          </a>
          <span class="text-slate-300 dark:text-slate-700">•</span>
          <a href={`mailto:${personal.email}`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
            {personal.email}
          </a>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${personal.email}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium transition-all shadow-md"
        >
          <Mail class="w-4 h-4" />
          <span>Email Turner</span>
        </a>
        <a
          href={personal.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-sm font-medium transition-all shadow-sm"
        >
          <Linkedin class="w-4 h-4 text-brand-600 dark:text-brand-400" />
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

    <div class="text-center text-xs text-slate-500 dark:text-slate-600 font-mono pt-4 border-t border-slate-100 dark:border-slate-900">
      © {new Date().getFullYear()} {personal.name} — Built with Astro & Tailwind CSS. Zero JavaScript footprint.
    </div>
  </div>
</footer>
