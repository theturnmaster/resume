---
import { resumeData } from '../data/resumeData';
import { ShieldCheck, Cpu, Code2 } from 'lucide-astro';

const { competencies } = resumeData;

const icons = [ShieldCheck, Cpu, Code2];
---

<section class="py-12 border-b border-slate-200 dark:border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-widest text-brand-600 dark:text-brand-400 font-semibold">
          Capability Matrix
        </h2>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mt-1 print:text-slate-900">
          Core Executive & Technical Competencies
        </h3>
      </div>
      <span class="text-xs text-slate-500 font-mono hidden sm:inline-block">
        Business Leadership + Tech Architecture
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {competencies.map((cat, idx) => {
        const IconComponent = icons[idx % icons.length];
        return (
          <div class="rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 p-6 flex flex-col justify-between shadow-sm dark:shadow-none hover:border-slate-300 dark:hover:border-slate-700 transition-all print:bg-white print:border-slate-300">
            <div>
              <div class="w-10 h-10 rounded-lg bg-brand-50 dark:bg-brand-500/10 border border-brand-200 dark:border-brand-500/20 flex items-center justify-center text-brand-600 dark:text-brand-400 mb-4 print:bg-slate-100 print:text-brand-600">
                <IconComponent class="w-5 h-5" />
              </div>
              
              <h4 class="text-lg font-bold text-slate-900 dark:text-slate-100 print:text-slate-900">
                {cat.title}
              </h4>
              
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 mb-4 leading-relaxed print:text-slate-600">
                {cat.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 print:border-slate-200">
              <div class="flex flex-wrap gap-1.5">
                {cat.skills.map(skill => (
                  <span class="inline-block px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 text-xs font-mono border border-slate-200 dark:border-slate-700/60 print:bg-slate-100 print:text-slate-800 print:border-slate-300">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
