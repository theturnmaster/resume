---
import { resumeData } from '../data/resumeData';
import { Calendar, MapPin, TrendingUp, CheckCircle2, Layers } from 'lucide-astro';

const { experiences } = resumeData;
---

<section class="py-12 border-b border-slate-200 dark:border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-widest text-brand-600 dark:text-brand-400 font-semibold">
          Career Trajectory
        </h2>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mt-1 print:text-slate-900">
          Professional Experience
        </h3>
      </div>
      <span class="text-xs text-slate-500 font-mono hidden sm:inline-block">
        Proven Revenue Growth & SLA Delivery
      </span>
    </div>

    <div class="space-y-8">
      {experiences.map((exp) => (
        <div class="relative pl-6 sm:pl-8 border-l-2 border-slate-200 dark:border-slate-800 print:border-slate-300 space-y-4">
          <!-- Timeline Node Marker -->
          <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-white dark:bg-slate-950 border-2 border-brand-500 print:bg-white print:border-brand-600"></div>

          <!-- Job Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h4 class="text-xl font-bold text-slate-900 dark:text-white print:text-slate-900">
                {exp.role}
              </h4>
              <div class="text-brand-600 dark:text-brand-400 font-medium text-sm print:text-brand-600">
                {exp.company}
              </div>
            </div>

            <div class="flex items-center gap-4 text-xs font-mono text-slate-500 dark:text-slate-400 print:text-slate-600">
              <span class="flex items-center gap-1">
                <Calendar class="w-3.5 h-3.5" />
                {exp.period}
              </span>
              <span class="flex items-center gap-1">
                <MapPin class="w-3.5 h-3.5" />
                {exp.location}
              </span>
            </div>
          </div>

          <!-- Description -->
          <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed print:text-slate-700">
            {exp.description}
          </p>

          <!-- Key Metrics Pills -->
          <div class="flex flex-wrap gap-2 pt-1">
            {exp.metrics.map(metric => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-500/20 text-xs font-mono font-medium print:bg-slate-100 print:text-slate-900 print:border-slate-300">
                <TrendingUp class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400" />
                {metric}
              </span>
            ))}
          </div>

          <!-- Bullet Achievements -->
          <ul class="space-y-2 pt-2">
            {exp.highlights.map(highlight => (
              <li class="flex items-start gap-2.5 text-sm text-slate-700 dark:text-slate-300 print:text-slate-800">
                <CheckCircle2 class="w-4 h-4 text-slate-400 dark:text-slate-500 shrink-0 mt-0.5" />
                <span>{highlight}</span>
              </li>
            ))}
          </ul>

          <!-- Tech Stack Badges -->
          <div class="flex items-center gap-2 pt-3">
            <span class="text-xs text-slate-500 font-mono flex items-center gap-1">
              <Layers class="w-3.5 h-3.5" />
              Stack:
            </span>
            <div class="flex flex-wrap gap-1.5">
              {exp.technologies.map(tech => (
                <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 text-xs font-mono print:bg-slate-50 print:text-slate-700 print:border-slate-200">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
