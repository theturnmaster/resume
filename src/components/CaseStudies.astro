---
import { resumeData } from '../data/resumeData';
import { ExternalLink, Briefcase, Sparkles, ArrowUpRight } from 'lucide-astro';

const { clientGroups } = resumeData;
---

<section class="py-12 border-b border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-widest text-brand-400 font-semibold">
          Featured Engagements & Case Studies
        </h2>
        <h3 class="text-2xl font-bold text-white mt-1 print:text-slate-900">
          Client Accounts & Digital Case Studies
        </h3>
      </div>
      <span class="text-xs text-slate-500 font-mono hidden sm:inline-block">
        7 Highlighted Projects Across 5 Client Accounts
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      {clientGroups.map(client => (
        <div class="lg:col-span-12 rounded-2xl bg-slate-900/60 border border-slate-800 p-6 lg:p-8 hover:border-slate-700 transition-all print:bg-white print:border-slate-300">
          <!-- Client Header Info -->
          <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-slate-800/80 print:border-slate-200 gap-4">
            <div>
              <div class="flex items-center gap-3">
                <h4 class="text-2xl font-extrabold text-white print:text-slate-900">
                  {client.clientName}
                </h4>
                <span class="px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-300 text-xs font-mono font-medium print:bg-slate-100 print:text-slate-800">
                  {client.clientRole}
                </span>
              </div>
              <p class="text-sm text-slate-400 mt-2 max-w-3xl print:text-slate-600">
                {client.description}
              </p>
            </div>

            <div class="shrink-0 font-mono text-xs text-slate-500 print:text-slate-600">
              <span>{client.caseStudies.length} Case {client.caseStudies.length > 1 ? 'Studies' : 'Study'}</span>
            </div>
          </div>

          <!-- Nested Case Study Grid -->
          <div class={`grid grid-cols-1 ${client.caseStudies.length > 1 ? 'md:grid-cols-2' : 'md:grid-cols-1'} gap-6 pt-6`}>
            {client.caseStudies.map(cs => (
              <div class="rounded-xl bg-slate-950/70 border border-slate-800/90 p-5 flex flex-col justify-between hover:border-brand-500/40 transition-all group print:bg-slate-50 print:border-slate-300">
                <div class="space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="px-2.5 py-0.5 rounded bg-slate-800/80 border border-slate-700/60 text-slate-300 text-xs font-mono print:bg-white print:text-slate-700">
                      {cs.category}
                    </span>
                    {cs.link && (
                      <a
                        href={cs.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-slate-400 group-hover:text-brand-400 transition-colors print:hidden flex items-center gap-1 text-xs font-mono"
                      >
                        <span>Case Study</span>
                        <ArrowUpRight class="w-3.5 h-3.5" />
                      </a>
                    )}
                  </div>

                  <h5 class="text-base font-bold text-slate-100 group-hover:text-brand-300 transition-colors print:text-slate-900">
                    {cs.title}
                  </h5>

                  <p class="text-xs text-slate-300 print:text-slate-700 leading-relaxed">
                    {cs.description}
                  </p>
                </div>

                {cs.link && (
                  <div class="pt-4 mt-4 border-t border-slate-900/80 print:border-slate-200">
                    <a
                      href={cs.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-brand-400 hover:text-brand-300 transition-colors"
                    >
                      <span>View Live Work & Portfolio Details</span>
                      <ExternalLink class="w-3 h-3" />
                    </a>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
