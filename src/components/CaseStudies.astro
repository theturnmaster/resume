---
import { resumeData } from '../data/resumeData';
import { Award, ArrowRight, CheckCircle } from 'lucide-astro';

const { caseStudies } = resumeData;
---

<section class="py-12 border-b border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-widest text-brand-400 font-semibold">
          High-Impact Transformations
        </h2>
        <h3 class="text-2xl font-bold text-white mt-1 print:text-slate-900">
          Featured Enterprise Case Studies
        </h3>
      </div>
      <span class="text-xs text-slate-500 font-mono hidden sm:inline-block">
        Technical Problem → Measurable ROI
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {caseStudies.map(cs => (
        <div class="rounded-xl bg-slate-900/60 border border-slate-800 p-6 flex flex-col justify-between hover:border-slate-700 transition-all print:bg-white print:border-slate-300">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-mono">
                {cs.clientCategory}
              </span>
              <Award class="w-4 h-4 text-slate-500" />
            </div>

            <h4 class="text-lg font-bold text-white leading-snug print:text-slate-900">
              {cs.title}
            </h4>

            <div class="space-y-2 text-xs">
              <div>
                <span class="font-mono font-semibold text-slate-400 uppercase">Challenge:</span>
                <p class="text-slate-300 print:text-slate-700 mt-0.5">{cs.challenge}</p>
              </div>

              <div>
                <span class="font-mono font-semibold text-slate-400 uppercase">Strategic & Tech Solution:</span>
                <p class="text-slate-300 print:text-slate-700 mt-0.5">{cs.solution}</p>
              </div>
            </div>

            <div class="pt-2">
              <span class="font-mono text-xs font-semibold text-brand-400 uppercase">Measurable Outcomes:</span>
              <ul class="mt-2 space-y-1.5">
                {cs.impact.map(item => (
                  <li class="flex items-center gap-2 text-xs text-slate-200 print:text-slate-800">
                    <ArrowRight class="w-3.5 h-3.5 text-brand-400 shrink-0" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-4 mt-6 border-t border-slate-800/80 flex flex-wrap gap-1.5">
            {cs.techStack.map(tech => (
              <span class="px-2 py-0.5 rounded bg-slate-800/60 text-slate-400 text-xs font-mono border border-slate-700/50 print:bg-slate-100 print:text-slate-700 print:border-slate-300">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
